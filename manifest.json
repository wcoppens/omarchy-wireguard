{
  "schemaVersion": 1,
  "id": "wcoppens.wireguard",
  "name": "WireGuard",
  "version": "1.0.0",
  "author": "Wesley Coppens",
  "license": "MIT",
  "description": "Show and toggle WireGuard VPN tunnels from the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "WireGuard",
    "description": "Toggle WireGuard tunnels, with a panel listing every config in /etc/wireguard.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 5,
      "exclusive": true,
      "defaultTunnel": ""
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 1,
        "max": 300,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "exclusive",
        "type": "boolean",
        "label": "Only one tunnel up at a time",
        "defaultValue": true
      },
      {
        "key": "defaultTunnel",
        "type": "string",
        "label": "Tunnel used by right click when none is up",
        "defaultValue": ""
      }
    ]
  }
}
